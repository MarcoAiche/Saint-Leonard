; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Saint-Leonard"
config/description="Koop-Jagd-, Offroad- und Dorfleben-Sandbox im Nachbau von Riegersdorf / St. Leonhard (Kärnten)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://assets/ui/icon.png"

[audio]

driver/enable_input=true

[autoload]

GameState="*res://scripts/core/game_state.gd"
Net="*res://scripts/net/net.gd"
Voice="*res://scripts/net/voice.gd"
DebugTools="*res://scripts/debug_tools.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=false

[physics]

common/max_physics_steps_per_frame=6
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=0
